# Names-only example. Do not place real credentials or deployment IDs in this file.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Required at runtime for /dev_history, /summarize, and deliberate command registration.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
DISCORD_ALLOWED_THREAD_IDS=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_ROLE_IDS=
# Required role allowlist for moderator-only commands such as /agent_report.
DISCORD_MOD_ROLE_IDS=
# Reserved for later project-to-thread communication work.
DISCORD_PROJECT_MAPPINGS_PATH=

# Public route expected by the application design.
DISCORD_INTERACTIONS_PATH=/discord/interactions

# These document a custom host launch. The Dockerfile binds its private container
# interface to 0.0.0.0:8080 and should be published only to host loopback.
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8080
